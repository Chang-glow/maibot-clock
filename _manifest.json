{
  "manifest_version": 2,
  "id": "local.maibot-clock",
  "version": "0.4.0",
  "name": "MaiBot Clock | 麦麦闹钟",
  "description": "让模型给自己定闹钟：延时、固定时间、cron，支持一次/多次/每次，到点交给 Planner 自行处理。",
  "author": {
    "name": "local",
    "url": "https://github.com/"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/local/maibot-clock"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "maisaka.proactive.trigger",
    "chat.get_all_streams"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "extension"
}
